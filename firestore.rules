rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Koleksi Karsa Tiket - Akses terbuka untuk latihan bootcamp Sesi 3 (Single-Role)
    match /event/{eventId} {
      allow read, write: if true;
    }
    match /pembeli/{noWhatsapp} {
      allow read, write: if true;
    }
    match /tiket/{tiketId} {
      allow read, write: if true;
    }
  }
}
